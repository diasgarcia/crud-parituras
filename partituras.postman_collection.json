      "item": [
        {
          "name": "Listar compositores",
          "request": {
            "method": "GET",
            "url": "{{api_url}}/compositores",
            "description": "Consulta os registros existentes.",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ]
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Retorna uma lista\", () => pm.expect(pm.response.json()).to.be.an(\"array\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Buscar compositor por ID",
          "request": {
            "method": "GET",
            "url": "{{api_url}}/compositores/{{compositor_id}}",
            "description": "Consulta o registro informado em {{compositor_id}}. Não cria nem exclui registros.",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ]
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Registro possui ID\", () => pm.expect(pm.response.json().id).to.be.a(\"number\").and.above(0));",
                  "pm.test(\"Retorna o ID informado\", () => pm.expect(pm.response.json().id).to.eql(Number(pm.variables.get(\"compositor_id\"))));"
                ]
              }
            }
          ]
        },
        {
          "name": "Cadastrar compositor",
          "request": {
            "method": "POST",
            "url": "{{api_url}}/compositores",
            "description": "Cadastra somente o registro descrito no corpo e mantém o cadastro no banco. Para as próximas operações, copie o ID retornado para a variável correspondente.",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"{{compositor_nome}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status HTTP 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"Registro possui ID\", () => pm.expect(pm.response.json().id).to.be.a(\"number\").and.above(0));",
                  "pm.test(\"Dados correspondem ao corpo enviado\", () => {",
                  "    const esperado = JSON.parse(pm.variables.replaceIn(pm.request.body.raw));",
                  "    const recebido = pm.response.json();",
                  "    for (const [campo, valor] of Object.entries(esperado)) {",
                  "        if (campo === \"compositor\" || campo === \"partitura\") pm.expect(recebido[campo].id).to.eql(valor.id);",
                  "        else pm.expect(recebido[campo]).to.deep.eql(valor);",
                  "    }",
                  "});"
                ]
              }
            }
          ]
        },
